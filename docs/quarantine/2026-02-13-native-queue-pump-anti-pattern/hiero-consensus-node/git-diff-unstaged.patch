+        if (isLongZeroAddress(explicitAddress)) {
+            return numberOfLongZero(explicitAddress);
+        }
+        if (isSolidityAddressFor(explicitAddress, shard, realm)) {
+            return ByteBuffer.wrap(explicitAddress, 12, Long.BYTES).getLong();
+        }
+        return null;
+    }
